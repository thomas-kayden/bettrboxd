{
  "name": "bettrboxd",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "build:beautify": "esbuild src/index.js --bundle --format=esm --minify=false --legal-comments=none --outfile=src/index.beautified.js",
    "build:mobile-nav": "esbuild frontend/src/mobile-navigation.tsx --bundle --format=iife --target=es2020 --jsx=automatic --minify --outfile=frontend/assets/mobile-navigation.js"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "wrangler": "4.64.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
